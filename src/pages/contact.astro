---
import Layout from '@/layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import { getContactPageContent, getSiteSettings } from '@/lib/cms';

const [settings, contactPage] = await Promise.all([getSiteSettings(), getContactPageContent()]);
---

<Layout title={contactPage?.title ?? 'Contact | BEL Hotel'} description={contactPage?.description ?? 'Contatta BEL Hotel per prenotazioni e informazioni.'}>
  <section class="pt-32 pb-16">
    <div class="container">
      <p class="text-primary mb-2 text-sm font-semibold tracking-wider uppercase">{contactPage?.heroEyebrow ?? 'Contatti'}</p>
      <h1 class="mb-4 text-4xl font-black md:text-5xl">{contactPage?.heroTitle ?? 'Parliamo del tuo prossimo soggiorno'}</h1>
      <p class="text-muted-foreground max-w-2xl">
        {contactPage?.heroDescription ?? 'Scrivici per prenotazioni, richieste speciali o informazioni sulle camere.'}
      </p>
    </div>
  </section>

  <section class="pb-20">
    <div class="container grid gap-8 lg:grid-cols-2">
      <div class="bg-card rounded-2xl border p-6 shadow-sm">
        <h2 class="mb-4 text-2xl font-semibold">{contactPage?.directInfoTitle ?? 'Informazioni dirette'}</h2>
        <ul class="space-y-3 text-sm md:text-base">
          <li><strong>Telefono:</strong> {settings?.phone ?? '+39 02 1234 5678'}</li>
          <li><strong>Email:</strong> {settings?.email ?? 'booking@belhotel.com'}</li>
          <li><strong>Indirizzo:</strong> {settings?.address ?? 'Via del Centro 10, Milano'}</li>
        </ul>
      </div>

      <form class="bg-card space-y-4 rounded-2xl border p-6 shadow-sm" method="post" action="#">
        <h2 class="text-2xl font-semibold">{contactPage?.formTitle ?? 'Richiedi disponibilità'}</h2>

        <div>
          <label for="name" class="mb-1 block text-sm font-medium">Nome e cognome</label>
          <input id="name" name="name" type="text" required class="border-input bg-background w-full rounded-lg border px-3 py-2" />
        </div>

        <div>
          <label for="email" class="mb-1 block text-sm font-medium">Email</label>
          <input id="email" name="email" type="email" required class="border-input bg-background w-full rounded-lg border px-3 py-2" />
        </div>

        <div>
          <label for="message" class="mb-1 block text-sm font-medium">Messaggio</label>
          <textarea id="message" name="message" rows={5} class="border-input bg-background w-full rounded-lg border px-3 py-2"></textarea>
        </div>

        <Button type="submit" className="w-full">Invia richiesta</Button>
      </form>
    </div>
  </section>
</Layout>
