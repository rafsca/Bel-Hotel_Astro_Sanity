---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import HotelDining from '@/assets/dining.jpeg';
import { getSiteSettings } from '@/lib/cms';

const settings = await getSiteSettings();
---

<Layout title="About | BEL Hotel" description="Scopri la storia e i valori BEL Hotel.">
  <section class="pt-32 pb-16">
    <div class="container grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="text-primary mb-2 text-sm font-semibold tracking-wider uppercase">About BEL Hotel</p>
        <h1 class="mb-4 text-4xl font-black md:text-5xl">Ospitalità contemporanea, anima italiana</h1>
        <p class="text-muted-foreground mb-4">
          BEL Hotel nasce con una missione chiara: offrire esperienze autentiche, comfort di livello e un servizio che faccia sentire ogni ospite davvero al centro.
        </p>
        <p class="text-muted-foreground">
          {settings?.description ?? 'Dalla qualità del riposo alla cura della ristorazione, ogni dettaglio è pensato per rendere il tuo soggiorno memorabile.'}
        </p>
      </div>

      <div class="overflow-hidden rounded-2xl border shadow-sm">
        <Image src={HotelDining} alt="Ristorante interno BEL Hotel" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="bg-secondary/40 py-20">
    <div class="container">
      <div class="grid gap-5 md:grid-cols-3">
        <article class="bg-card rounded-2xl border p-6 shadow-sm">
          <h2 class="mb-2 text-xl font-semibold">Visione</h2>
          <p class="text-muted-foreground">Creare un nuovo standard di ospitalità urbana, elegante ma accessibile.</p>
        </article>

        <article class="bg-card rounded-2xl border p-6 shadow-sm">
          <h2 class="mb-2 text-xl font-semibold">Servizio</h2>
          <p class="text-muted-foreground">Team preparato, attento e sempre disponibile, 24 ore su 24.</p>
        </article>

        <article class="bg-card rounded-2xl border p-6 shadow-sm">
          <h2 class="mb-2 text-xl font-semibold">Qualità</h2>
          <p class="text-muted-foreground">Materiali premium, ambienti curati e attenzione costante ai dettagli.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>
