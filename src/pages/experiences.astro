---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import HotelBg from '@/assets/hotel_bg.jpeg';
import Dining from '@/assets/dining.jpeg';
import Room1 from '@/assets/hotel_room1.jpeg';
import { Button } from '@/components/ui/button';
import { getExperiencesPageContent, isSanityConfigured, urlFor, type FeaturedCard } from '@/lib/cms';

const page = await getExperiencesPageContent();

const fallbackCards: FeaturedCard[] = [
  {
    title: 'Food & Wine',
    description: 'Degustazioni, percorsi gastronomici e tavole d’autore selezionate.',
  },
  {
    title: 'Wellness',
    description: 'Momenti di relax e trattamenti dedicati al tuo benessere.',
  },
  {
    title: 'Culture & City',
    description: 'Visite guidate e attività culturali nei luoghi iconici della città.',
  },
];

const cards: FeaturedCard[] = page?.cards?.length ? page.cards : fallbackCards;
const fallbackAssets = [Dining, Room1, HotelBg];
---

<Layout title={page?.title ?? 'Experiences | BEL Hotel'} description={page?.description ?? 'Scopri le esperienze disponibili durante il soggiorno.'}>
  <section class="pt-32 pb-16">
    <div class="container">
      <p class="text-primary mb-2 text-sm font-semibold tracking-wider uppercase">{page?.heroEyebrow ?? 'Experiences'}</p>
      <h1 class="mb-4 text-4xl font-black md:text-5xl">{page?.heroTitle ?? 'Vivi il territorio in modo autentico'}</h1>
      <p class="text-muted-foreground max-w-2xl">
        {page?.heroDescription ?? 'Proponiamo esperienze selezionate per trasformare ogni soggiorno in un ricordo memorabile.'}
      </p>
    </div>
  </section>

  <section class="pb-20">
    <div class="container">
      <h2 class="mb-8 text-2xl font-semibold md:text-3xl">{page?.sectionTitle ?? 'Esperienze in evidenza'}</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {cards.map((card, index) => (
          <article class="bg-card h-full overflow-hidden rounded-2xl border shadow-sm flex flex-col">
            {card.image && urlFor(card.image)?.width(900).height(560).url() ? (
              <img
                src={urlFor(card.image)?.width(900).height(560).url()}
                alt={card.imageAlt ?? card.title ?? 'Experience'}
                class="h-56 w-full object-cover"
                loading="lazy"
              />
            ) : (
              <Image src={fallbackAssets[index % fallbackAssets.length]} alt={card.title ?? 'Experience'} class="h-56 w-full object-cover" />
            )}
            <div class="flex flex-1 flex-col p-5">
              <h3 class="mb-2 text-xl font-semibold">{card.title ?? 'Esperienza'}</h3>
              <p class="text-muted-foreground mb-5">{card.description ?? 'Contenuto aggiornabile da Sanity Studio.'}</p>
              <Button asChild variant="outline" className="mt-auto w-full">
                <a href="/contact">Richiedi informazioni</a>
              </Button>
            </div>
          </article>
        ))}
      </div>

      {!isSanityConfigured && (
        <p class="text-muted-foreground mt-6 text-sm">Per usare contenuti reali da CMS configura le variabili Sanity nel progetto.</p>
      )}
    </div>
  </section>
</Layout>
